{
  "expo": {
    "name": "Riffology",
    "slug": "riff-engine-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/riffology-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "riff-engine",
    "splash": {
      "image": "./assets/brand/riffology-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.riffengine.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/riffology-icon.png",
        "backgroundColor": "#FFF9E8"
      },
      "package": "com.riffengine.mobile",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/riffology-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": true
        }
      ],
      "expo-iap",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets Riffology show you more relevant ads while keeping the riff generator free."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-8042868551988044~1477465638",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46b60852-cc4d-46c8-a3a7-2917bd6803b2"
      }
    }
  }
}
