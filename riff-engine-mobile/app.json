{
  "expo": {
    "name": "Riffology",
    "slug": "riff-engine-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/riffology-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "riff-engine",
    "splash": {
      "image": "./assets/brand/riffology-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riffengine.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/riffology-icon.png",
        "backgroundColor": "#FFF9E8"
      },
      "package": "com.riffengine.mobile",
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/riffology-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46b60852-cc4d-46c8-a3a7-2917bd6803b2"
      }
    }
  }
}
